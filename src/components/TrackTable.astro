---
import { formatDuration } from '../lib/format';
import type { TrackRow } from '../lib/audio';

// rows = tracks paired with their release (see lib/audio.ts)
// showRelease = false on a release page, where the release is already obvious
const { rows, showRelease = true } = Astro.props as { rows: TrackRow[]; showRelease?: boolean };
---
{rows.length === 0 ? (
    <p class="empty">No tracks yet.</p>
) : (
    <div class="table-wrap">
        <table class="track-table">
            <thead>
                <tr>
                    <th scope="col" class="num">#</th>
                    <th scope="col">Title</th>
                    <th scope="col" class="artist">Artist</th>
                    {showRelease && <th scope="col" class="release">Release</th>}
                    <th scope="col" class="genre">Genre</th>
                    <th scope="col" class="num bpm">BPM</th>
                    <th scope="col" class="num time">Time</th>
                </tr>
            </thead>
            <tbody>
                {rows.map(({ track, release }) => (
                    <tr data-track={track.id} data-audio={track.data.audio}>
                        <td class="num">{track.data.trackNumber}</td>
                        <td class="title">{track.data.title}</td>
                        <td class="artist">{track.data.artist}</td>
                        {showRelease && <td class="release"><a href={`/audio/${release.id}/`}>{release.data.title}</a></td>}
                        <td class="genre">{track.data.genre}</td>
                        <td class="num bpm" data-label="BPM">{track.data.bpm}</td>
                        <td class="num time">{formatDuration(track.data.duration)}</td>
                    </tr>
                ))}
            </tbody>
        </table>
    </div>
)}

<style>
    /* scroll the table, not the page, on narrow screens */
    .table-wrap {
        overflow-x: auto;
        margin-top: var(--space-lg);
    }

    .track-table {
        width: 100%;
        border-collapse: collapse;
        font-variant-numeric: tabular-nums;
    }

    th, td {
        padding: var(--space-xs) var(--space-sm);
        text-align: left;
        white-space: nowrap;
        border-bottom: 1px solid var(--color-text-subtle);
    }

    thead th {
        font-size: var(--text-sm);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-text-subtle);
        border-bottom-color: var(--color-text-heading);
    }

    .num {
        text-align: right;
    }

    .title {
        font-weight: bold;
        color: var(--color-text-heading);
    }

    /* phones: each track becomes two lines instead of a sideways-scrolling table
       line 1: number, title, time    line 2: release, BPM */
    @media (max-width: 40rem) {
        .table-wrap {
            overflow-x: visible;
        }

        thead {
            position: absolute; /* keep for screen readers */
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
        }

        .track-table,
        tbody {
            display: block;
        }

        tbody tr {
            display: grid;
            grid-template-columns: 2em minmax(0, 1fr) auto;
            column-gap: var(--space-sm);
            padding: var(--space-xs) 0;
            border-bottom: 1px solid var(--color-text-subtle);
        }

        td {
            padding: 0;
            border: 0;
            white-space: normal;
        }

        td.num:first-child {
            grid-row: 1 / span 2;
            align-self: center;
            color: var(--color-text-subtle);
        }

        td.title {
            grid-column: 2;
            overflow-wrap: anywhere;
        }

        td.time {
            grid-column: 3;
            grid-row: 1;
        }

        td.release {
            grid-column: 2;
            grid-row: 2;
            font-size: var(--text-sm);
            overflow-wrap: anywhere;
        }

        td.bpm {
            grid-column: 3;
            grid-row: 2;
            font-size: var(--text-sm);
            color: var(--color-text-subtle);
        }

        td.bpm::after {
            content: " " attr(data-label);
        }

        /* artist and genre are on the release page and in search; hidden here for space */
        td.artist,
        td.genre {
            display: none;
        }
    }

    .empty {
        margin-top: var(--space-lg);
        color: var(--color-text-subtle);
    }
</style>
