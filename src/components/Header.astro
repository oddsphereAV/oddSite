---
// The address of the page being shown
const path = Astro.url.pathname;
---

<header class="site-header">
    <a href="/">
         <img src="/assets/img/logo.svg" alt="Oddsphere home" class="site-logo">
    </a>
    
    <nav class="site-nav">
        <ul class="nav-list">
            <li><a href="/" aria-current={path === '/' ? 'page' : undefined} > Home </a></li>
            <li><a href="/audio/" aria-current={path.startsWith('/audio') ? 'page' : undefined}> Audio </a></li>
            <li><a href="/graphics/" aria-current={path.startsWith('/graphics') ? 'page' : undefined}> Graphics </a></li>
            <li><a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}> About </a></li>
        </ul>
    </nav>
</header>


<style>
    .site-header {
        display: flex;
        align-items: center;
        flex-direction: column;
        gap: var(--space-md);
    }

    .site-nav {
        max-width: 100%;
    }

    .site-header nav {
        justify-content: safe center;
    }

    @media (min-width: 48rem) {
        .site-header {
            flex-direction: row;
            justify-content: space-between;
        }
    }

    .site-logo {
        display: block;
        width: 20rem;
    }

    .nav-list {
        display: grid;
        grid-template-columns: repeat(2, auto);
        justify-content: center;
        justify-items: center;
        gap: var(--space-xs) var(--space-md);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    @media (min-width: 24rem) {
        .nav-list {
            grid-template-columns: repeat(4, auto);
        }
    }
</style>
