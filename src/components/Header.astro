---
// The address of the page being shown
const path = Astro.url.pathname;
---

<header class="site-header">
    <a href="/" class="site-logo-link">
         <img src="/assets/img/logo.svg" alt="Oddsphere home" class="site-logo">
    </a>

    <!-- Only shown on phones, and only when JavaScript is on (otherwise the nav is simply open) -->
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="nav-toggle-label">Menu</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main">
        <ul class="nav-list">
            <li><a href="/" aria-current={path === '/' ? 'page' : undefined} > Home </a></li>
            <li><a href="/audio/" aria-current={path.startsWith('/audio') ? 'page' : undefined}> Audio </a></li>
            <li><a href="/graphics/" aria-current={path.startsWith('/graphics') ? 'page' : undefined}> Graphics </a></li>
            <li><a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}> About </a></li>
        </ul>
    </nav>
</header>

<script>
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const nav = document.querySelector<HTMLElement>('.site-nav');

    function setOpen(open: boolean) {
        toggle?.setAttribute('aria-expanded', String(open));
        toggle?.querySelector('.nav-toggle-label')!.replaceChildren(open ? 'Close' : 'Menu');
        nav?.classList.toggle('is-open', open);
    }

    toggle?.addEventListener('click', () => {
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes the menu and returns focus to the button
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            toggle.focus();
        }
    });
</script>

<style>
    .site-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-sm) var(--space-md);
    }

    .site-logo-link {
        display: block;
        min-width: 0;
    }

    .site-logo {
        display: block;
        width: 14rem;
    }

    .nav-toggle {
        display: none; /* shown below on phones when JavaScript is on */
        font: inherit;
        font-size: var(--text-sm);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-text-heading);
        background: transparent;
        border: 1px solid currentColor;
        border-radius: 4px;
        padding: var(--space-xs) var(--space-md);
        min-height: 2.75rem;
        cursor: pointer;
    }

    .nav-toggle:focus-visible {
        outline: 2px solid var(--color-link);
        outline-offset: 3px;
    }

    .site-nav {
        flex-basis: 100%;
    }

    .site-nav a,
    .site-nav a:visited {
        color: var(--color-link);
        text-decoration: none;
    }

    .site-nav a:hover {
        color: var(--color-text-heading);
    }

    .site-nav a[aria-current="page"],
    .site-nav a[aria-current="page"]:visited {
        color: var(--color-text-heading);
        font-weight: bold;
    }

    .nav-list {
        display: flex;
        flex-direction: column;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /* big tap targets with a rule between items */
    .nav-list a {
        display: flex;
        align-items: center;
        min-height: 2.75rem;
        border-top: 1px solid var(--color-text-subtle);
    }

    /* phones with JavaScript: menu button, nav hidden until opened */
    @media (max-width: 47.99rem) {
        :global(.js) .nav-toggle {
            display: block;
        }

        :global(.js) .site-nav:not(.is-open) {
            display: none;
        }
    }

    /* tablets and up: logo left, links in a row on the right */
    @media (min-width: 48rem) {
        .site-header {
            flex-wrap: nowrap;
        }

        .site-logo {
            width: 20rem;
        }

        .site-nav {
            flex-basis: auto;
        }

        .nav-list {
            flex-direction: row;
            gap: var(--space-md);
        }

        .nav-list a {
            min-height: 0;
            border-top: 0;
        }
    }
</style>
