---
// What each card receives from one page
// width/height = image resolution
const { src, alt, title, width, height } = Astro.props;
---
<!-- Parameter locations -->
<figure class="gallery-item">
    <img 
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
    />
    <figcaption> {title} </figcaption>
</figure>

<style>
    .gallery-item img {
        width: 100%;
        height: auto;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: 4px;
    }

    .gallery-item figcaption {
        margin-top: var(--space-xs);
        font-size: var(--text-sm);
        color: var(--color-text-subtle);
    }
</style>
