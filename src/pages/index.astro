---
// Import components
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Grid from '../components/Grid.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
---
<!DOCTYPE html>
<html lang="en">
	
	<!-- Head Component -->
    <Head>
        <title>Oddsphere.net</title>
    </Head>
	<!-- -------------- -->

    <body>
        <!-- Header Component -->
		<Header></Header>
        <!-- ---------------- -->

		
        <main id="main">
            <div class="grid">
                <section class="col--6 col--6@md card">
                    <h2> Latest release </h2>
                    <iframe class="bandcamp" src="https://bandcamp.com/EmbeddedPlayer/track=3255353671/size=large/bgcol=282a2b/linkcol=1287ea/tracklist=false/transparent=true/" seamless><a href="https://soundzorganiccollective.bandcamp.com/track/neuromancer">Neuromancer by Oddsphere</a></iframe>
                    <p><a href="/audio/">See all audio</a></p>
                </section>

                <section class="col--6 col--6@md card">
                    <h2> Recent graphics </h2>
                    <Grid>
                        <ArtworkCard
                            src="https://graphics.oddsphere.net/abiogenesis.jpg"
                            alt="Abiogenesis Poster"
                            title="Abiogenesis | Poster"
                            width={2160}
                            height={2880}
                            showTitle={false}
                            href="/graphics/"
                        />
                    </Grid>
                    <p><a href="/graphics/">See all graphics</a></p>
                </section>
            </div>
        </main>

        <!-- Footer Component -->
        <Footer></Footer>
        <!-- ---------------- -->
    </body>
</html>

<style>
    /* Grid adds its own top margin; match the heading-to-content gap of the player */
    section :global(.gallery-grid) {
        margin-top: 0;
    }

    /* iframes are inline by default and leave a gap below */
    .bandcamp {
        width: 100%;
        height: 100cqw; /* square: crops the controls bar, play button stays on the artwork */
        border: 0;
        display: block;
    }

    .card {
        container-type: inline-size;
    }

    /* align the first heading in each column with the top of the row */
    .grid > section > :first-child {
        margin-top: 0;
    }
</style>
