---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Grid from "../components/Grid.astro";
import ArtworkCard from "../components/ArtworkCard.astro";
import discovery from '../assets/img/discovery.png'
---

<!DOCTYPE html>
<html lang="en">
    <!-- Head Component -->
    <Head>
        <title> Graphics </title>
    </Head>
	<!-- -------------- -->
    
    <body>
        <!-- Header Component -->
		<Header></Header>
        <!-- ---------------- -->

        <main id="main">
            <section>
                <h1> Graphics </h1>
                
                <!-- Gallery Component -->
                <Grid>
                    <ArtworkCard
                        src="https://graphics.oddsphere.net/graphics/abiogenesis.jpg"
                        alt="Abiogenesis Poster"
                        title="Abiogenesis | Poster"
                        width={2160}
                        height={2880}
                    />
                </Grid> 
                <!-- ---------------- -->
            
            </section>
        </main>

        <!-- Footer Component -->
        <Footer></Footer>
        <!-- ---------------- -->
    </body>
</html>