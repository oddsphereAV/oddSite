---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Grid from "../components/Grid.astro";
---

<!DOCTYPE html>
<html lang="en">
    <!-- Head Component -->
    <Head>
        <title>Audio</title>
    </Head>
	<!-- -------------- -->
    
    <body>
        <!-- Header Component -->
		<Header></Header>
        <!-- ---------------- -->

        <main id="main">
            <section>
                <h1> Audio </h1>

                <Grid>
                    <figure class="gallery-item">
                        <iframe src="https://bandcamp.com/EmbeddedPlayer/track=3255353671/size=large/bgcol=282a2b/linkcol=1287ea/tracklist=false/transparent=true/" seamless><a href="https://soundzorganiccollective.bandcamp.com/track/neuromancer">Neuromancer by Oddsphere</a></iframe>
                    </figure>

                    <figure class="gallery-item">
                        <iframe src="https://bandcamp.com/EmbeddedPlayer/track=2539753180/size=large/bgcol=181a1b/linkcol=35393b/tracklist=false/transparent=true/" seamless><a href="https://oddsphere.bandcamp.com/track/flipside">Flipside by Oddsphere</a></iframe>
                    </figure>

                    <figure class="gallery-item">
                        <iframe src="https://bandcamp.com/EmbeddedPlayer/track=1991053895/size=large/bgcol=181a1b/linkcol=bd7b07/tracklist=false/transparent=true/" seamless><a href="https://oddsphere.bandcamp.com/track/globert-de-niro">Globert De Niro by Oddsphere</a></iframe>
                    </figure>
                </Grid>
            </section>
        </main>

        <!-- Footer Component -->
        <Footer></Footer>
        <!-- ---------------- -->
    </body>
</html>