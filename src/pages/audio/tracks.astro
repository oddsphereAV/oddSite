---
import Head from '../../components/Head.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AudioTabs from '../../components/AudioTabs.astro';
import TrackTable from '../../components/TrackTable.astro';
import { getTrackRows } from '../../lib/audio';

const rows = await getTrackRows();
---

<!DOCTYPE html>
<html lang="en">
    <Head>
        <title>Tracks | Oddsphere</title>
    </Head>

    <body>
        <Header></Header>

        <main id="main">
            <section>
                <h1> Audio </h1>
                <AudioTabs />
                <TrackTable rows={rows} />
            </section>
        </main>

        <Footer></Footer>
    </body>
</html>
