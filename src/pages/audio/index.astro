---
import Head from '../../components/Head.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Grid from '../../components/Grid.astro';
import ArtworkCard from '../../components/ArtworkCard.astro';
import AudioTabs from '../../components/AudioTabs.astro';
import { getReleases, typeLabel } from '../../lib/audio';

const releases = await getReleases();
---

<!DOCTYPE html>
<html lang="en">
    <Head>
        <title>Audio</title>
    </Head>

    <body>
        <Header></Header>

        <main id="main">
            <section>
                <h1> Audio </h1>
                <AudioTabs />

                {releases.length === 0 ? (
                    <p>No releases yet.</p>
                ) : (
                    <Grid>
                        {releases.map((release) => (
                            <ArtworkCard
                                src={release.data.cover!.url}
                                alt={release.data.cover!.alt}
                                title={`${release.data.title} | ${typeLabel[release.data.type]} ${release.data.date.getFullYear()}`}
                                width={release.data.cover!.width}
                                height={release.data.cover!.height}
                                href={`/audio/${release.id}/`}
                            />
                        ))}
                    </Grid>
                )}
            </section>
        </main>

        <Footer></Footer>
    </body>
</html>
