---
import { render } from 'astro:content';
import Head from '../../components/Head.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TrackTable from '../../components/TrackTable.astro';
import { getReleases, getTrackRows, typeLabel } from '../../lib/audio';

// One page per published release
export async function getStaticPaths() {
    const releases = await getReleases();
    const rows = await getTrackRows();

    return releases.map((release) => ({
        params: { release: release.id },
        props: {
            release,
            rows: rows.filter((row) => row.release.id === release.id),
        },
    }));
}

const { release, rows } = Astro.props;
const { Content } = await render(release);
const { title, artist, type, date, cover, bandcamp } = release.data;
---

<!DOCTYPE html>
<html lang="en">
    <Head><title>{title} | Oddsphere</title></Head>

    <body>
        <Header></Header>

        <main id="main">
            <p><a href="/audio/">&larr; All releases</a></p>

            <div class="grid release">
                <div class="col--12 col--4@md">
                    <img src={cover!.url} alt={cover!.alt} width={cover!.width} height={cover!.height} class="cover" />
                </div>

                <div class="col--12 col--8@md text-container">
                    <h1>{title}</h1>
                    <p class="meta">
                        {artist} &middot; {typeLabel[type]} &middot; {date.getFullYear()}
                    </p>
                    <Content />
                    {bandcamp && <p><a href={bandcamp} target="_blank" rel="noopener">Buy / download on Bandcamp</a></p>}
                </div>
            </div>

            <TrackTable rows={rows} showRelease={false} />
        </main>

        <Footer></Footer>
    </body>
</html>

<style>
    .release {
        margin-top: var(--space-md);
    }

    .cover {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: 4px;
    }

    .meta {
        color: var(--color-text-subtle);
    }

    .release h1 {
        margin-top: 0;
    }
</style>
